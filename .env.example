# Copy to .env (gitignored). Values come from WHC -> hosting -> SFTP/SSH section.
host=
port=27
user=
# Only needed for interactive SFTP clients; the deploy scripts use the SSH key instead.
password=
# Staging logins (user:password). Copy from ~/.staging-basicauth and ~/.staging-admin on the server.
staging_basic_auth=
staging_wp_admin=
